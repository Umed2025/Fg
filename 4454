@bot.callback_query_handler(func=lambda call: call.data.startswith("check_"))
def check_subscription(call):
    bot.answer_callback_query(call.id)

    user_id = call.from_user.id
    ad_id = call.data.replace("check_", "")

    ad = data["ads"].get(ad_id)

    if not ad or ad["status"] != "approved":
        bot.send_message(
            call.message.chat.id,
            "❌ Это задание недоступно."
        )
        return

    if ad["owner"] == user_id:
        bot.send_message(
            call.message.chat.id,
            "❌ Нельзя выполнять собственное задание."
        )
        return

    if str(user_id) in ad["completed"]:
        bot.send_message(
            call.message.chat.id,
            "Ты уже получил награду за это задание."
        )
        return

    try:
        member = bot.get_chat_member(
            ad["channel"],
            user_id
        )

        if member.status not in (
            "member",
            "administrator",
            "creator"
        ):
            bot.send_message(
                call.message.chat.id,
                "❌ Подписка не найдена. Сначала подпишись на канал."
            )
            return

    except Exception:
        bot.send_message(
            call.message.chat.id,
            "❌ Не удалось проверить подписку. "
            "Возможно, боту не хватает прав в канале."
        )
        return

    with data_lock:
        if str(user_id) in ad["completed"]:
            return

        ad["completed"].append(str(user_id))

        user = get_user(user_id)
        user["balance"] += AD_REWARD

        referrer_id = user.get("referrer")

        if referrer_id:
            referrer = get_user(referrer_id)

            referral_reward = AD_REWARD * REFERRAL_TASK_PERCENT / 100

            referrer["balance"] += referral_reward
            referrer["referral_earnings"] += referral_reward

            if not user["referral_bonus_given"]:
                referrer["balance"] += REFERRAL_BONUS
                user["referral_bonus_given"] = True

        save_data()

    bot.send_message(
        call.message.chat.id,
        f"✅ Подписка подтверждена!\n"
        f"Тебе начислено {AD_REWARD} GRAM."
    )


