# ================== ПРОВЕРКА ССЫЛКИ ==================

def parse_public_channel_link(value):
    value = value.strip()

    if value.startswith("@"):
        username = value[1:]

    else:
        parsed = urlparse(value)

        if parsed.scheme != "https":
            return None

        if parsed.netloc.lower() not in ("t.me", "www.t.me"):
            return None

        username = parsed.path.strip("/").split("/")[0]

    if not username:
        return None

    if not username.replace("_", "").isalnum():
        return None

    return "@" + username


