@bot.message_handler(func=lambda message: message.from_user.id in waiting_ad_link)
def receive_ad_link(message):
    user_id = message.from_user.id

    channel = parse_public_channel_link(message.text)

    if not channel:
        bot.send_message(
            message.chat.id,
            "❌ Неверная ссылка.\n"
            "Используй @channel или https://t.me/channel"
        )
        return

    try:
        member = bot.get_chat_member(channel, user_id)

        if member.status not in ("administrator", "creator"):
            bot.send_message(
                message.chat.id,
                "❌ Ты должен быть администратором этого канала."
            )
            return

        bot_member = bot.get_chat_member(
            channel,
            bot.get_me().id
        )

        if bot_member.status != "administrator":
            bot.send_message(
                message.chat.id,
                "❌ Сначала добавь бота администратором канала."
            )
            return

    except Exception:
        bot.send_message(
            message.chat.id,
            "❌ Не удалось проверить канал.\n"
            "Проверь ссылку и права бота."
        )
        return

    user = get_user(user_id)

    if user["balance"] < AD_CREATE_COST:
        waiting_ad_link.discard(user_id)

        bot.send_message(
            message.chat.id,
            "❌ Недостаточно GRAM."
        )
        return

    with data_lock:
        user["balance"] -= AD_CREATE_COST

        ad_id = str(data["next_ad_id"])
        data["next_ad_id"] += 1

        data["ads"][ad_id] = {
            "channel": channel,
            "owner": user_id,
            "status": "pending",
            "completed": []
        }

        save_data()

    waiting_ad_link.discard(user_id)

    bot.send_message(
        message.chat.id,
        "✅ Реклама отправлена на проверку администрации."
    )

    try:
        bot.send_message(
            ADMIN_ID,
            f"📢 Новая реклама!\n\n"
            f"Канал: {channel}\n"
            f"ID рекламы: {ad_id}\n"
            f"Автор: {user_id}",
            reply_markup=moderation_keyboard(ad_id)
        )
    except Exception:
        pass


