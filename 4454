# ================== ДАННЫЕ ==================

def default_data():
    return {
        "users": {},
        "ads": {},
        "next_ad_id": 1
    }


def load_data():
    if not os.path.exists(DATA_FILE):
        return default_data()

    try:
        with open(DATA_FILE, "r", encoding="utf-8") as file:
            loaded = json.load(file)

        loaded.setdefault("users", {})
        loaded.setdefault("ads", {})
        loaded.setdefault("next_ad_id", 1)

        return loaded

    except (json.JSONDecodeError, OSError):
        return default_data()


data = load_data()


def save_data():
    with data_lock:
        temp_file = DATA_FILE + ".tmp"

        with open(temp_file, "w", encoding="utf-8") as file:
            json.dump(data, file, ensure_ascii=False, indent=4)

        os.replace(temp_file, DATA_FILE)


def get_user(user_id):
    user_id = str(user_id)

    with data_lock:
        if user_id not in data["users"]:
            data["users"][user_id] = {
                "balance": START_BALANCE,
                "completed": [],
                "referrals": [],
                "referrer": None,
                "referral_bonus_given": False,
                "referral_earnings": 0
            }

        user = data["users"][user_id]

        user.setdefault("balance", START_BALANCE)
        user.setdefault("completed", [])
        user.setdefault("referrals", [])
        user.setdefault("referrer", None)
        user.setdefault("referral_bonus_given", False)
        user.setdefault("referral_earnings", 0)

        return user


