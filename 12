def parse_public_channel_link(text):
    text = text.strip()

    if text.startswith("@"):
        username = text[1:]
        if username and username.replace("_", "").isalnum():
            return "@" + username
        return None

    if not text.startswith(("https://t.me/", "http://t.me/")):
        return None

    parsed = urlparse(text)
    if parsed.netloc.lower() not in ("t.me", "www.t.me"):
        return None

    path = parsed.path.strip("/").split("/")

    if not path:
        return None

    username = path[0]

    if username in ("joinchat", "c") or username.startswith("+"):
        return None

    if not username.replace("_", "").isalnum():
        return None

    return "@" + username


@bot.message_handler(func=lambda message: message.from_user.id in waiting_ad_link)
def receive_ad_link(message):
    user_id = message.from_user.id
    waiting_ad_link.discard(user_id)

    channel = parse_public_channel_link(message.text or "")

    if not channel:
        bot.send_message(
            message.chat.id,
            "Неверная ссылка. Отправь публичный канал в формате "
            "@channel или https://t.me/channel"
        )
        return

    try:
        member = bot.get_chat_member(channel, user_id)
        if member.status not in ("administrator", "creator"):
            bot.send_message(
                message.chat.id,
                "Ты должен быть администратором рекламируемого канала."
            )
            return
    except Exception:
        bot.send_message(
            message.chat.id,
            "Не удалось проверить канал. Убедись, что канал публичный "
            "и бот может получить информацию о нём."
        )
        return

    user = get_user(user_id)

    if user["balance"] < AD_CREATE_COST:
        bot.send_message(message.chat.id, "Недостаточно средств.")
        return

    with data_lock:
        user["balance"] -= AD_CREATE_COST

        ad_id = str(data["next_ad_id"])
        data["next_ad_id"] += 1

        data["ads"][ad_id] = {
            "owner_id": str(user_id),
            "channel": channel,
            "active": False,
            "status": "pending"
        }

        user["created_ads"].append(ad_id)
        save_data()

    bot.send_message(
        message.chat.id,
        f"✅ Реклама отправлена на проверку.\n"
        f"Списано: {AD_CREATE_COST} GRAM.\n"
        f"ID рекламы: {ad_id}\n"
        "После одобрения она станет видна пользователям."
    )

    try:
        bot.send_message(
            ADMIN_ID,
            f"🆕 Новая реклама на проверку\n"
            f"ID: {ad_id}\n"
            f"Владелец: {user_id}\n"
            f"Канал: {channel}",
            reply_markup=moderation_keyboard(ad_id)
        )
    except Exception:
        pass


