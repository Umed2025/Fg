    )


@bot.callback_query_handler(func=lambda call: call.data.startswith("check:"))
def check_subscription(call):
    ad_id = call.data.split(":", 1)[1]
    user_id = str(call.from_user.id)

    ad = data["ads"].get(ad_id)
    user = get_user(call.from_user.id)

    if not ad or ad.get("status", "approved") != "approved":
        bot.answer_callback_query(call.id, "Задание недоступно", show_alert=True)
        return

    if ad.get("owner_id") == user_id:
        bot.answer_callback_query(call.id, "Нельзя выполнять свою рекламу", show_alert=True)
        return

    if ad_id in user["completed_ads"]:
        bot.answer_callback_query(call.id, "Ты уже выполнил это задание", show_alert=True)
        return

    try:
        member = bot.get_chat_member(ad["channel"], call.from_user.id)

        if member.status not in ("member", "administrator", "creator"):
            bot.answer_callback_query(
                call.id,
                "Сначала подпишись на канал",
                show_alert=True
            )
            return
    except Exception:
        bot.answer_callback_query(
            call.id,
            "Не удалось проверить подписку. Попробуй позже.",
            show_alert=True
        )
        return

    with data_lock:
        user["balance"] += AD_REWARD
        user["completed_ads"].append(ad_id)

        referrer_id = user.get("referred_by")
        if referrer_id:
            referrer = get_user(int(referrer_id))
            referral_reward = AD_REWARD * REFERRAL_TASK_PERCENT / 100
            referrer["balance"] += referral_reward
            referrer["referral_task_earnings"] += referral_reward

            if not user.get("referral_bonus_paid"):
                referrer["balance"] += REFERRAL_BONUS
                user["referral_bonus_paid"] = True

        save_data()

    bot.answer_callback_query(call.id, "Подписка подтверждена!")
    bot.send_message(
        call.message.chat.id,
        f"✅ Задание выполнено!\nНачислено {AD_REWARD} GRAM."
    )


