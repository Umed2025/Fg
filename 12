# ================== ХРАНЕНИЕ ДАННЫХ ==================

def default_data():
    return {
        "users": {},
        "ads": {},
        "next_ad_id": 1
    }


def load_data():
    if not os.path.exists(DATA_FILE):
        return default_data()

    try:
        with open(DATA_FILE, "r", encoding="utf-8") as file:
            loaded = json.load(file)

        loaded.setdefault("users", {})
        loaded.setdefault("ads", {})
        loaded.setdefault("next_ad_id", 1)

        for user in loaded["users"].values():
            user.setdefault("balance", 0)
            user.setdefault("completed_ads", [])
            user.setdefault("created_ads", [])
            user.setdefault("referrals", [])
            user.setdefault("referred_by", None)
            user.setdefault("referral_bonus_paid", False)
            user.setdefault("referral_task_earnings", 0)

        # Старые объявления считаются одобренными
        for ad in loaded["ads"].values():
            ad.setdefault("status", "approved")
            ad.setdefault("active", True)

        return loaded

    except (json.JSONDecodeError, OSError):
        return default_data()


data = load_data()


def save_data():
    with data_lock:
        temp_file = DATA_FILE + ".tmp"
        with open(temp_file, "w", encoding="utf-8") as file:
            json.dump(data, file, ensure_ascii=False, indent=2)
        os.replace(temp_file, DATA_FILE)


def get_user(user_id):
    user_id = str(user_id)

    with data_lock:
        if user_id not in data["users"]:
            data["users"][user_id] = {
                "balance": START_BALANCE,
                "completed_ads": [],
                "created_ads": [],
                "referrals": [],
                "referred_by": None,
                "referral_bonus_paid": False,
                "referral_task_earnings": 0
            }

        user = data["users"][user_id]
        user.setdefault("balance", 0)
        user.setdefault("completed_ads", [])
        user.setdefault("created_ads", [])
        user.setdefault("referrals", [])
        user.setdefault("referred_by", None)
        user.setdefault("referral_bonus_paid", False)
        user.setdefault("referral_task_earnings", 0)

        return user


