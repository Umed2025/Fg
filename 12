@bot.callback_query_handler(func=lambda call: call.data.startswith("reject:"))
def reject_ad(call):
    if call.from_user.id != ADMIN_ID:
        bot.answer_callback_query(call.id, "Нет доступа", show_alert=True)
        return

    ad_id = call.data.split(":", 1)[1]
    ad = data["ads"].get(ad_id)

    if not ad or ad.get("status") != "pending":
        bot.answer_callback_query(call.id, "Объявление уже проверено")
        return

    owner_id = str(ad["owner_id"])

    with data_lock:
        owner = get_user(int(owner_id))
        owner["balance"] += AD_CREATE_COST

        if ad_id in owner["created_ads"]:
            owner["created_ads"].remove(ad_id)

        del data["ads"][ad_id]
        save_data()

    bot.answer_callback_query(call.id, "Реклама отклонена, средства возвращены")

    try:
        bot.send_message(
            int(owner_id),
            f"❌ Твоя реклама {ad['channel']} отклонена.\n"
            f"Возвращено {AD_CREATE_COST} GRAM."
        )
    except Exception:
        pass

    try:
        bot.edit_message_reply_markup(
            call.message.chat.id,
            call.message.message_id,
            reply_markup=None
        )
    except Exception:
        pass


